# ==============================================================================
# Jarvis 2.0 Git Ignore Specification
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# C / C++ build artifacts
*.obj
*.o
*.pdb
*.ilk
*.exp
*.lib

# Virtual Environment
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Large binaries & model weights (Kokoro, Whisper, ONNX)
data/models/
*.onnx

# Browser debug runtime profiles & cache
data/browser_debug_profile/

# Runtime SQLite databases, WAL & Shared Memory locks
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
*.db-wal
*.db-shm
*.db-journal
data/test_memory.db

# Runtime screenshots, photos, intake documents & temporary workspaces
data/screenshots/
data/photos/*.jpg
data/intake/*.pdf
data/agy_runtime_workspace/*
!data/agy_runtime_workspace/.gitkeep
.agy_lock

# Repository dumps & Repomix outputs
repomix-output.xml
jarvis_codebase.txt
jarvis_core_src.txt
*.repomix*

# Release archives
release/*.zip

# Environment & credentials
.env

# OS / Editor clutter
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
*.log
