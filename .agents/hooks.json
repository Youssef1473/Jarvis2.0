{
  "safety-watchdog": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "if exist tools\\watchdog_hook.py (python tools\\watchdog_hook.py) else (python ..\\tools\\watchdog_hook.py)",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "python-lint-diagnostic": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "if exist tools\\lint_hook.py (python tools\\lint_hook.py) else (python ..\\tools\\lint_hook.py)",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "context-router": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "if exist tools\\context_router.py (python tools\\context_router.py) else (python ..\\tools\\context_router.py)",
        "timeout": 5
      }
    ]
  },
  "continuity-checker": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "if exist tools\\continuity_manager.py (python tools\\continuity_manager.py hook-session-start) else (python ..\\tools\\continuity_manager.py hook-session-start)",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "if exist tools\\continuity_manager.py (python tools\\continuity_manager.py hook-check) else (python ..\\tools\\continuity_manager.py hook-check)",
        "timeout": 5
      }
    ]
  },
  "failure-collector": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "if exist tools\\failure_collector.py (python tools\\failure_collector.py) else (python ..\\tools\\failure_collector.py)",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "if exist tools\\failure_collector.py (python tools\\failure_collector.py) else (python ..\\tools\\failure_collector.py)",
        "timeout": 5
      }
    ]
  }
}
