# ==============================================================================
# Jarvis 2.0 Environment Configuration Template
# Copy to .env and populate keys for the providers you intend to use.
# ==============================================================================

# Primary Cloud Specialists / Fallback Providers:
# Google Gemini API key (required if llm.provider="gemini" or using Gemini specialist)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API key (optional; required if using direct Anthropic API specialist)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key (optional; required if using direct OpenAI provider)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API key (required if llm.provider="openrouter" or using OpenRouter cascade)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq API key (optional; required if llm.provider="groq")
GROQ_API_KEY=your_groq_api_key_here
